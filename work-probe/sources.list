# Project sources compiled into the probe, relative to the repository root. Globs are expanded by
# stage.sh. Nothing is copied: stage.sh symlinks every file into a throwaway SwiftPM package under
# $TMPDIR, except the two build-only substitutes it generates (see stage.sh).
#
# Two executables, as in the product: the App side parses and publishes into a container directory,
# the tunnel side reads that directory and runs the engine. They share nothing but those files.

[tunnel]
# the engine as the ClashmacOSExtension target lists it (project.yml), without the packet tunnel,
# the kernel adapter and the widget/route files the engine does not use
apple/ClashClient/Extension/Module/*.swift
apple/ClashClient/Sources/ConfigStore/ModuleIR.swift
apple/ClashClient/Sources/ConfigStore/ModuleRegexDeadline.swift
apple/ClashClient/Sources/ConfigStore/ModuleHostList.swift
apple/ClashClient/Sources/ConfigStore/ModuleEngineContract.swift
apple/ClashClient/Sources/ConfigStore/ModuleCertificateAuthority.swift
apple/ClashClient/Sources/ConfigStore/ModuleCertificateIssuing.swift
apple/ClashClient/Sources/ConfigStore/ModuleJQ/*.swift
apple/ClashClient/Sources/ConfigStore/ModuleScript/*.swift
apple/ClashClient/Sources/ConfigStore/ModuleScriptFamilyFormat.swift
apple/ClashClient/Sources/SystemIntegration/ModuleScriptNotificationMailbox.swift
apple/ClashClient/Sources/SystemIntegration/ModuleScriptNotificationPoster.swift
apple/ClashClient/Shared/ClashAppIdentifiers.swift
apple/ClashClient/Shared/ClashAppGroupContainer.swift

[app]
# The App side is the ClashmacOS target's own source set (project.yml), so the module store,
# parser, activation and CA code run exactly as the App runs them. stage.sh takes @main off the App
# struct (the probe's main.swift is the entry point) and none of the App's views is ever shown.
apple/ClashClient/Sources/**/*.swift
apple/ClashClient/Shared/**/*.swift
Vendor/ClashAdapter/Sources/ClashAdapter/**/*.swift
!apple/ClashClient/Sources/TV/*
!apple/ClashClient/Sources/ClashClientApp.swift
!apple/ClashClient/Sources/ClashNavigationLab.swift
!apple/ClashClient/Sources/ClashPushClockTouchProbe.swift
!apple/ClashClient/Sources/VPNController.swift
!apple/ClashClient/Sources/ClashComponents.swift
!apple/ClashClient/Sources/OverviewComponents.swift
!apple/ClashClient/Sources/OverviewContent.swift
!apple/ClashClient/Sources/OverviewDetailCards.swift
!apple/ClashClient/Sources/OverviewPrimaryCards.swift
!apple/ClashClient/Sources/HomeView.swift
!apple/ClashClient/Sources/NodesView.swift
!apple/ClashClient/Sources/ConfigUI/GoldenFlowHomeView.swift
!apple/ClashClient/Sources/ConfigUI/TunnelSettingsView.swift
